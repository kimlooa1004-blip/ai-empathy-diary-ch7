# OpenRouter 키 — 6장 .env에서 복사해 넣는다. 이 파일에는 값을 적지 않는다.
OPENROUTER_API_KEY=
# 1차 모델. 무료 모델은 수시로 바뀌므로 환경변수로 받는다.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# 폴백 모델. 1차가 실패하면 한 번 더 시도한다.
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3.5-super-vl:free
# 제한시간(밀리초)
OPENROUTER_TIMEOUT_MS=40000
OPENROUTER_FALLBACK_TIMEOUT_MS=50000
# OpenRouter 주소. 시험에서 가짜 서버를 가리키게 하려고 뺐다.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# SQLite 파일 위치(1단계). 2단계에서는 DATABASE_URL로 바뀐다.
DIARY_DB_PATH=data/diary.db
